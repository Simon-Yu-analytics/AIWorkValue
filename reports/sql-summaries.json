    {
      "query": "03_baseline_balance",
      "sql": "-- Balance diagnostic among retained primary-arm cases with observed baseline.\n-- SMD = (AI mean - control mean) / sqrt((AI sample variance + control sample variance) / 2).\n-- This does not prove balance in all randomized participants or remove attrition bias.\nWITH baseline_long AS (\n    SELECT assignment, 'time_minutes' AS outcome, time_pre AS baseline\n    FROM participants WHERE primary_arm = 1 AND time_pre IS NOT NULL\n    UNION ALL\n    SELECT assignment, 'quality_points', grade_pre\n    FROM participants WHERE primary_arm = 1 AND grade_pre IS NOT NULL\n), moments AS (\n    SELECT outcome, assignment, COUNT(*) AS n, AVG(baseline) AS mean,\n           (SUM(baseline * baseline) - SUM(baseline) * SUM(baseline) / COUNT(*))\n               / NULLIF(COUNT(*) - 1, 0) AS sample_variance\n    FROM baseline_long GROUP BY outcome, assignment\n), paired AS (\n    SELECT c.outcome, c.n AS control_n, a.n AS ai_n,\n           c.mean AS control_mean, a.mean AS ai_mean,\n           (c.sample_variance + a.sample_variance) / 2.0 AS pooled_variance\n    FROM moments AS c JOIN moments AS a ON c.outcome = a.outcome\n    WHERE c.assignment = 0 AND a.assignment = 1\n)\nSELECT outcome, control_n, ai_n, control_mean, ai_mean,\n       ai_mean - control_mean AS baseline_mean_difference,\n       CASE WHEN pooled_variance > 0\n            THEN (ai_mean - control_mean) / SQRT(pooled_variance) END AS standardized_mean_difference\nFROM paired ORDER BY outcome;\n",
      "rows": [
        {
          "outcome": "quality_points",
          "control_n": 186,
          "ai_n": 166,
          "control_mean": 3.9696236559139786,
          "ai_mean": 3.968875502008032,
          "baseline_mean_difference": -0.0007481539059464026,
          "standardized_mean_difference": -0.0005852840315863421
        },
        {
          "outcome": "time_minutes",
          "control_n": 180,
          "ai_n": 167,
          "control_mean": 28.969444444444445,
          "ai_mean": 29.802395209580837,
          "baseline_mean_difference": 0.8329507651363919,
          "standardized_mean_difference": 0.05707506141260815
        }
      ]
    },
    {
      "query": "04_paired_changes",
      "sql": "-- Descriptive changes use exactly the same baseline/post pairs within each outcome.\n-- This unadjusted difference in changes is not the Python ANCOVA coefficient.\nWITH group_changes AS (\n    SELECT outcome, assignment, COUNT(*) AS n,\n           AVG(baseline) AS baseline_mean, AVG(post) AS post_mean,\n           AVG(post - baseline) AS mean_change\n    FROM v_outcome_pairs GROUP BY outcome, assignment\n)\nSELECT c.outcome, c.n AS control_n, a.n AS ai_n,\n       c.baseline_mean AS control_baseline, a.baseline_mean AS ai_baseline,\n       c.post_mean AS control_post, a.post_mean AS ai_post,\n       c.mean_change AS control_change, a.mean_change AS ai_change,\n       a.mean_change - c.mean_change AS unadjusted_difference_in_changes\nFROM group_changes AS c JOIN group_changes AS a ON c.outcome = a.outcome\nWHERE c.assignment = 0 AND a.assignment = 1 ORDER BY c.outcome;\n",
